# Public browser configuration only. Fill these with the actual frontend/Auth setup.
# The separate current server owns all provider, billing, database and sandbox secrets.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Optional: Firebase Auth does not require Storage or Messaging configuration.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
